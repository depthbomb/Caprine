<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <LangVersion>15</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Caprine.Durations</Title>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <FileVersion>0.1.0</FileVersion>
        <NeutralLanguage>en-US</NeutralLanguage>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1572;CS1573;CS1574;CS1587</WarningsAsErrors>
        <Deterministic>true</Deterministic>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>0.1.0</Version>
        <Description>Compile-time duration literals and calendar arithmetic for .NET.</Description>
        <PackageTags>duration;timespan;calendar;source-generator</PackageTags>
        <Authors>Caprine Logic</Authors>
        <Company>Caprine Logic</Company>
        <Copyright>Copyright (c) 2026 Caprine Logic</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/depthbomb/Caprine/tree/master/Caprine.Durations</PackageProjectUrl>
        <RepositoryUrl>https://github.com/depthbomb/Caprine</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Caprine.Durations.Generators/Caprine.Durations.Generators.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"/>
        <None Include="../Caprine.Durations.Generators/bin/$(Configuration)/netstandard2.0/Caprine.Durations.Generators.dll"
              Pack="true" PackagePath="analyzers/dotnet/roslyn5.12/cs" Visible="false"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
