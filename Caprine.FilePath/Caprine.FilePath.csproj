<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>15</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Caprine.FilePath</Title>
        <Description>A lightweight class for .NET inspired by Python’s pathlib.</Description>
        <Copyright>Copyright (c) 2026 Caprine Logic</Copyright>
        <AssemblyVersion>0.2.0</AssemblyVersion>
        <FileVersion>0.2.0</FileVersion>
        <NeutralLanguage>en-US</NeutralLanguage>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1572;CS1573;CS1587</WarningsAsErrors>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>0.2.0</Version>
        <PackageProjectUrl>https://github.com/depthbomb/Caprine/tree/master/Caprine.FilePath</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/depthbomb/Caprine/tree/master/Caprine.FilePath</RepositoryUrl>
        <Company>Caprine Logic</Company>
        <Authors>Caprine Logic</Authors>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
